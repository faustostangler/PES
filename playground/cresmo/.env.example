# ==============================================================================
# Cresmo Knowledge Ingestion & Synthesis Pipeline Configuration (.env)
# Architecture: Doctor Stangler Method (Clean / Hexagonal DDD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 Category 1: Secrets & Credentials (MANDATORY IN PRODUCTION)
# Never commit actual values to Git or version control.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# 🟡 Category 2: Infra & Topology (Optional Overrides)
# Sane defaults auto-resolve relative to playground/cresmo repository location.
# ------------------------------------------------------------------------------
# CRESMO_ROOT=/absolute/path/to/cresmo
# CRESMO_RAW_DIR=/absolute/path/to/raw
# CRESMO_ENRICHED_DIR=/absolute/path/to/enriched
# CRESMO_WIKI_DIR=/absolute/path/to/wiki
# CRESMO_COOKIES_FILE=/absolute/path/to/.yt_dlp_cookies.txt
# ANTIGRAVITY_BRAIN_DIR=/home/user/.gemini/antigravity-ide/brain
# ANTIGRAVITY_AGENTAPI_BINARY=/home/user/.gemini/antigravity-ide/bin/agentapi
# ANTIGRAVITY_LS_ADDRESS=127.0.0.1:41667
# ANTIGRAVITY_CSRF_TOKEN=ff53390d-3617-40f6-836e-6c5375ff5817
# ANTIGRAVITY_FALLBACK_CONVERSATION_ID=0e69775c-ba22-4a48-ad18-ba6a318c9a04

# ------------------------------------------------------------------------------
# 🟢 Category 3: Operational Tunables (LLM Provider, Concurrency & Polling)
# ------------------------------------------------------------------------------
# Active LLM Provider ("gemini" | "ollama" | "mock")
# CRESMO_LLM_PROVIDER=gemini

# Google Gemini Tunables
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_OUTPUT_TOKENS=65536
# GEMINI_REQUEST_TIMEOUT=180.0
# GEMINI_ENABLE_STREAMING=true

# Defensive Retry Policy for LLM Calls
# CRESMO_RETRY_MAX_ATTEMPTS=7
# CRESMO_RETRY_MULTIPLIER=2.0
# CRESMO_RETRY_MIN_SECONDS=2.0
# CRESMO_RETRY_MAX_SECONDS=60.0

# Ollama Tunables (Local Inference)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini

# Ingestion Concurrency Tunables
# (If omitted: resolves to 1 in debug mode, or os.cpu_count() in production)
# CRESMO_MAX_WORKERS=4
# CRESMO_DAYS_LOOKBACK=730
# CRESMO_WHISPER_MODEL=base
# CRESMO_KEEP_AUDIO=false

# Pipeline Thresholds & Limits
# DEFAULT_STAGE2_PASSES=3
# POLL_MAX_ATTEMPTS=300
# POLL_SLEEP_SECONDS=1.0
# PROMPT_MAX_BYTES_INLINE=120000

# External Configuration File (YAML, TOML, JSON)
# CRESMO_CONFIG_FILE=/path/to/cresmo_config.yaml
