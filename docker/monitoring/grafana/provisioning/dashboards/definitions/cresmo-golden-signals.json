  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SRE Golden Signal: Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "p95 and p50 duration of pipeline synthesis stages partitioned by stage, channel_name, and channel_id.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Pipeline Stage Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(cresmo_pipeline_stage_duration_seconds_bucket{channel_name=~\"$channel_name\", channel_id=~\"$channel_id\"}[5m])))",
          "legendFormat": "{{stage}} (p95)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, stage) (rate(cresmo_pipeline_stage_duration_seconds_bucket{channel_name=~\"$channel_name\", channel_id=~\"$channel_id\"}[5m])))",
          "legendFormat": "{{stage}} (p50)",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "p95 duration of media ingestion and transcription partitioned by channel and modality.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Media Ingestion Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, modality, status) (rate(cresmo_media_ingestion_duration_seconds_bucket{channel_name=~\"$channel_name\", channel_id=~\"$channel_id\"}[5m])))",
          "legendFormat": "{{modality}} - {{status}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Roundtrip latency of external LLM API completions.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "LLM Request Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, model, role) (rate(cresmo_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}} ({{role}})",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
