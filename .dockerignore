# Git & VCS
.git/
.gitignore

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mutmut-cache/

# Virtual Environments
.venv/
env/
venv/

# Environment files & secrets (12-Factor App: Never bake secrets)
.env*

# Operational Data & Vault Storage (Mounted at runtime via volumes)
data/
vault/
playground/

# IDE & Editor artifacts
.vscode/
.idea/
.agents/

# Temporary files
*.tmp
*.log
