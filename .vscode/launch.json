{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cresmo: Run (Full Pipeline)",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "run"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Run (Force Re-process)",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "run",
                "--force-reprocess"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Run (Dry-Run)",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "run",
                "--dry-run"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Run Single Video",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "run",
                "--url",
                "https://www.youtube.com/watch?v=REPLACE_ME"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Priority List (Only)",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "run",
                "--manifest",
                "${workspaceFolder}/data/playlist-priority.txt"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Dedupe Entities (Stage 7)",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "dedupe"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Cresmo: Check Config",
            "type": "debugpy",
            "request": "launch",
            "module": "cresmo.presentation.cli",
            "args": [
                "check-config"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "justMyCode": false
        }
    ]
}