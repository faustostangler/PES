# =============================================================================
# Cresmo Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secret tokens.
# Do NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Category 1: External AI Providers & LLM Keys
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key-here"

# -----------------------------------------------------------------------------
# Category 2: Langfuse Observability & Telemetry (Machine-to-Machine)
# -----------------------------------------------------------------------------
# Self-hosted default: http://localhost:3000
# Cloud default: https://cloud.langfuse.com
LANGFUSE_HOST="http://localhost:3000"
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Category 3: Self-Hosted Langfuse Admin Credentials (Human Web UI Access)
# Used only to access the dashboard at http://localhost:3000
# -----------------------------------------------------------------------------
LANGFUSE_ADMIN_EMAIL="admin@cresmo.local"
LANGFUSE_ADMIN_PASSWORD="your-secure-admin-password"

# -----------------------------------------------------------------------------
# Category 4: Operational Settings & Directory Layout
# -----------------------------------------------------------------------------
DATA_DIR="data"
VAULT_DIR="vault"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
BATCH_SIZE=5
GAP_FILLER_PASSES=3
