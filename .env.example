# =============================================================================
# Cresmo Environment Configuration Template (.env.example)
# Canonical Contract (ADR-074): CRESMO_<SECTION>__<SUBSECTION>__<FIELD>
# Copy this file to .env and provide your secret tokens.
# Do NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Category 1: External AI Providers & LLM Keys
# -----------------------------------------------------------------------------
CRESMO_LLM__GEMINI__API_KEYS="your-google-gemini-api-key-here"
CRESMO_LLM__GEMINI__MODEL="gemini-3.5-flash-lite"
CRESMO_LLM__GEMINI__FALLBACK_MODEL="gemini-3.6-flash"
# minimal | low | medium | high | xhigh (auto-clamped per model)
CRESMO_LLM__GEMINI__THINKING_LEVEL="low"
CRESMO_LLM__GEMINI__MAX_OUTPUT_TOKENS=32768
# Available Free-Tier Text & Multimodal Models (GEMINI_FREE_TIER_MODELS):
#   gemini-3.5-flash-lite   | gemini-3.8-flash      | gemini-3.6-flash
#   gemini-4-hydrogen       | gemini-3.1-flash-lite | gemini-3-flash-preview
#   gemma-4-31b-it          | gemma-4-26b-a4b-it    | gemini-2.5-flash-lite
#   gemini-2.5-flash        | gemini-2.5-pro

# -----------------------------------------------------------------------------
# Category 2: Quality Judge & Evaluators
# -----------------------------------------------------------------------------
CRESMO_JUDGE__PROVIDER="gemini"
CRESMO_JUDGE__GEMINI__MODEL="gemini-3.5-flash-lite"
CRESMO_JUDGE__GEMINI__THINKING_LEVEL="low"
# CRESMO_JUDGE__TYPESAFE__API_KEY=""
# CRESMO_JUDGE__TYPESAFE__MODEL="jev-latest"
# CRESMO_JUDGE__TYPESAFE__BASE_URL="https://api.typesafe.ai/v1"

# -----------------------------------------------------------------------------
# Category 3: Langfuse Observability & Telemetry (Machine-to-Machine)
# -----------------------------------------------------------------------------
# Self-hosted default: http://localhost:3000 | Cloud default: https://cloud.langfuse.com
CRESMO_OBSERVABILITY__LANGFUSE__HOST="http://localhost:3000"
CRESMO_OBSERVABILITY__LANGFUSE__PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
CRESMO_OBSERVABILITY__LANGFUSE__SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# lowercase [a-z0-9-_], max 40 chars, cannot start with 'langfuse'
CRESMO_OBSERVABILITY__LANGFUSE__ENVIRONMENT="staging"

# -----------------------------------------------------------------------------
# Category 4: Self-Hosted Langfuse Admin Credentials (Human Web UI Access)
# Used only to access the dashboard at http://localhost:3000
# -----------------------------------------------------------------------------
LANGFUSE_ADMIN_EMAIL="admin@cresmo.local"
LANGFUSE_ADMIN_PASSWORD="your-secure-admin-password"

# -----------------------------------------------------------------------------
# Category 5: Storage, Pipeline Budgets & Worker Pools
# -----------------------------------------------------------------------------
CRESMO_STORAGE__DATA_DIR="data"
CRESMO_STORAGE__VAULT_DIR="vault"
CRESMO_PIPELINE__BATCH_SIZE=5
CRESMO_PIPELINE__STAGES__EXPANSION_MAX_PASSES=5
CRESMO_PIPELINE__STAGES__LONG_EXPANDER_MAX_PASSES=7
CRESMO_INGESTION__WORKERS__WHISPER=1
CRESMO_INGESTION__WORKERS__SUBTITLE=5
CRESMO_INGESTION__WORKERS__CHANNEL_DISCOVERY=10
# High-throughput media ingestion options (ADR-075)
# CRESMO_INGESTION__WHISPER_DEVICE="auto"
# CRESMO_INGESTION__WHISPER_COMPUTE_TYPE="auto"
# CRESMO_INGESTION__WHISPER_VAD_FILTER=true
# CRESMO_INGESTION__ENABLE_RSS_FAST_PATH=true

# -----------------------------------------------------------------------------
# Category 6: Logging & Structured Observability (ADR-025 / ADR-044)
# -----------------------------------------------------------------------------
CRESMO_OBSERVABILITY__LOGGING__LEVEL="INFO"
# 'json' for Loki structured ingestion, 'text' for local dev
CRESMO_OBSERVABILITY__LOGGING__FORMAT="json"
